+% PeTTa applies Work to the unit argument [] (apply_fn1(F,[],R)). Under
+% pymetta, with Atom-typed arguments, Work arrives as an unevaluated call
+% expression (a list) or a bare function name; apply it to [] by appending.
+pc_apply_unit(F, R) :- is_list(F), F = [H|_], H \== '|->', !,
+    append(F, [[]], Call), reduce(Call, R).
+pc_apply_unit(F, R) :- atom(F), !, reduce([F, []], R).
+pc_apply_unit(F, R) :- reduce([F], R).
 
