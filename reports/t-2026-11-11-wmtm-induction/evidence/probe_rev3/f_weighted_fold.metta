; rev3 probe: fold strength = antecedent-mass-weighted average of consequent strengths (3 instances, unequal masses)
!(import! &self ../../pettachainer/metta/petta_chainer)
!(compileadd K (: a1 (Member i1 A) (STV 1.0 0.9)))
!(compileadd K (: a2 (Member i2 A) (STV 1.0 0.5)))
!(compileadd K (: a3 (Member i3 A) (STV 1.0 0.9)))
!(compileadd K (: b1 (Member i1 B) (STV 1.0 0.9)))
!(compileadd K (: b2 (Member i2 B) (STV 0.2 0.9)))
!(compileadd K (: b3 (Member i3 B) (STV 0.4 0.9)))
!(println! (collapse (query 200 K (: $prf (Inheritance A B) $tv))))
