+_STV_TAIL = re.compile(r"\(STV\s+([^\s()]+)\s+([^\s()]+)\)\s*\)\s*$")
+
+
+def _stv_in_range(text: str) -> bool:
+    """Numeric (STV s c) must have s and c in [0, 1]; non-numeric (variables) pass."""
+    m = _STV_TAIL.search(text)
+    if not m:
+        return True
+    try:
+        s, c = float(m.group(1)), float(m.group(2))
+    except ValueError:
+        return True
+    return 0.0 <= s <= 1.0 and 0.0 <= c <= 1.0
+
+
 def check_stmt(text: str) -> float:
     """Return 1.0 for valid evaluated statement forms, else 0.0."""
 
